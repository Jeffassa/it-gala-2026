{
  "permissions": {
    "allow": [
      "PowerShell(Get-Process | Where-Object { $_.ProcessName -eq 'python' } | Stop-Process -Force; Start-Sleep -Seconds 2; Write-Output \"killed\")",
      "Bash(curl -s -o /dev/null -w \"Backend: %{http_code}\\\\n\" http://127.0.0.1:8000/health)",
      "Bash(docker compose *)"
    ]
  }
}
